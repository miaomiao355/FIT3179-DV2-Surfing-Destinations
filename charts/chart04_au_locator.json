{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia locator inset with the Gold Coast–Tweed map extent highlighted.",
  "width": "container",
  "height": 78,
  "padding": 0,
  "background": "#f7faf8",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 110
  },
  "layer": [
    {
      "name": "Australia locator outline",
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d8e4e2",
        "stroke": "#84999c",
        "strokeWidth": 0.8,
        "interactive": false
      }
    },
    {
      "name": "Gold Coast Tweed map extent",
      "data": {
        "values": [
          {
            "type": "Feature",
            "properties": {
              "name": "Gold Coast–Tweed extent"
            },
            "geometry": {
              "type": "Polygon",
              "coordinates": [
                [
                  [
                    152.96,
                    -28.38
                  ],
                  [
                    153.98,
                    -28.38
                  ],
                  [
                    153.98,
                    -27.86
                  ],
                  [
                    152.96,
                    -27.86
                  ],
                  [
                    152.96,
                    -28.38
                  ]
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": "#42616a",
        "fillOpacity": 0.14,
        "stroke": "#354f58",
        "strokeWidth": 1.1,
        "interactive": false
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
