{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chronological event schedule with zero-anchored inclusive duration endpoints.",
  "width": 900,
  "height": 560,
  "padding": {
    "left": 0,
    "right": 4,
    "top": 32,
    "bottom": 45
  },
  "background": "#FAF9F6",
  "data": {
    "values": []
  },
  "encoding": {
    "y": {
      "field": "Event",
      "type": "nominal",
      "sort": {
        "field": "Start_ms",
        "op": "min",
        "order": "ascending"
      },
      "axis": null
    },
    "tooltip": [
      {
        "field": "Event",
        "title": "Event",
        "type": "nominal"
      },
      {
        "field": "Venue_label",
        "title": "Venue",
        "type": "nominal"
      },
      {
        "field": "Start_label",
        "title": "Start date",
        "type": "nominal"
      },
      {
        "field": "End_label",
        "title": "End date",
        "type": "nominal"
      },
      {
        "field": "Duration_days",
        "title": "Duration (days)",
        "type": "quantitative",
        "format": "d"
      }
    ]
  },
  "layer": [
    {
      "name": "duration-rule",
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Duration_days",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              10
            ],
            "nice": false,
            "range": [
              500,
              900
            ]
          },
          "axis": {
            "title": "Duration (days)",
            "values": [
              0,
              2,
              4,
              6,
              8,
              10
            ],
            "grid": true,
            "gridColor": "#E5E2DB",
            "domain": false,
            "tickColor": "#AABFC3",
            "labelColor": "#102B3A",
            "titleColor": "#102B3A",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "labelPadding": 6,
            "titlePadding": 10
          }
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "condition": {
            "test": "datum.Is_longest",
            "value": "#C47B32"
          },
          "value": "#176B76"
        }
      }
    },
    {
      "name": "duration-endpoint",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": "#FAF9F6",
        "strokeWidth": 1.2,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Duration_days",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              10
            ],
            "nice": false,
            "range": [
              500,
              900
            ]
          },
          "axis": {
            "title": "Duration (days)",
            "values": [
              0,
              2,
              4,
              6,
              8,
              10
            ],
            "grid": true,
            "gridColor": "#E5E2DB",
            "domain": false,
            "tickColor": "#AABFC3",
            "labelColor": "#102B3A",
            "titleColor": "#102B3A",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "labelPadding": 6,
            "titlePadding": 10
          }
        },
        "color": {
          "condition": {
            "test": "datum.Is_longest",
            "value": "#C47B32"
          },
          "value": "#176B76"
        }
      }
    },
    {
      "name": "event-title",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": 700,
        "color": "#102B3A",
        "lineBreak": "\n",
        "lineHeight": 17,
        "limit": 200
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "text": {
          "field": "Timeline_title",
          "type": "nominal"
        }
      }
    },
    {
      "name": "event-venue",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 400,
        "color": "#102B3A",
        "lineBreak": "\n",
        "lineHeight": 17,
        "limit": 200
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "text": {
          "field": "Venue_label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "event-date",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 400,
        "color": "#102B3A",
        "lineBreak": "\n",
        "lineHeight": 17,
        "limit": 200
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "text": {
          "field": "Timeline_date",
          "type": "nominal"
        }
      }
    },
    {
      "name": "event-heading",
      "data": {
        "values": [
          {
            "label": "EVENT"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -20
        },
        "text": {
          "field": "label"
        },
        "tooltip": null
      }
    },
    {
      "name": "venue-heading",
      "data": {
        "values": [
          {
            "label": "VENUE"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -20
        },
        "text": {
          "field": "label"
        },
        "tooltip": null
      }
    },
    {
      "name": "date-heading",
      "data": {
        "values": [
          {
            "label": "DATES"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -20
        },
        "text": {
          "field": "label"
        },
        "tooltip": null
      }
    },
    {
      "name": "duration-heading",
      "data": {
        "values": [
          {
            "label": "DURATION"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -20
        },
        "text": {
          "field": "label"
        },
        "tooltip": null
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI"
    }
  }
}
