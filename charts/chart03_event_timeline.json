            "utc": true
          },
          {
            "year": 2026,
            "month": 3,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 4,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 5,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 6,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 7,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 8,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 9,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 10,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 11,
            "date": 1,
            "utc": true
          },
          {
            "year": 2026,
            "month": 12,
            "date": 1,
            "utc": true
          }
        ],
        "labelAngle": 0,
        "labelFontSize": 12,
        "grid": true,
        "labelPadding": 8,
        "orient": "top",
        "gridColor": "#E5E2DB",
        "labelColor": "#586773",
        "tickSize": 0,
        "domain": false
      }
    },
    "y": {
      "field": "Timeline_label",
      "type": "nominal",
      "sort": {
        "field": "Start_ms",
        "op": "min",
        "order": "ascending"
      },
      "axis": null
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA"
        ],
        "range": [
          "#4263A0",
          "#8667A8",
          "#22857F",
          "#C47B32"
        ]
      },
      "legend": {
        "title": "Event state",
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "circle",
        "symbolSize": 110,
        "labelFontSize": 13,
        "titleFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "Event",
        "type": "nominal",
        "title": "Event"
      },
      {
        "field": "Location",
        "type": "nominal",
        "title": "Location"
      },
      {
