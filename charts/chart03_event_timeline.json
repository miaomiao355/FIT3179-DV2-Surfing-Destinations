                "date": 1,
                "utc": true
              },
              {
                "year": 2026,
                "month": 12,
                "date": 1,
                "utc": true
              }
            ],
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "labelPadding": 8,
            "orient": "top",
            "gridColor": "#E5E2DB",
            "labelColor": "#586773",
            "tickSize": 0,
            "domain": false
          }
        },
        "opacity": {
          "condition": {
            "param": "end_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.92
        }
      },
      "params": [
        {
          "name": "end_hover",
          "select": {
            "type": "point",
            "fields": [
              "Event"
            ],
            "on": "pointerover",
