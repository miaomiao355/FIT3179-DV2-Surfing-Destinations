        "type": "nominal",
        "title": "End (inclusive)"
      },
      {
        "field": "Duration_days",
        "type": "quantitative",
        "title": "Listed days",
        "format": "d"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#102B3A",
      "titleColor": "#102B3A",
      "gridColor": "#E5E2DB",
      "domainColor": "#c8d4d5",
      "tickColor": "#c8d4d5",
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#586773",
      "titleColor": "#183d50",
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "font": "Segoe UI"
  },
  "layer": [
    {
      "name": "event-interval",
      "mark": {
        "type": "rule",
        "strokeWidth": 3.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x2": {
          "field": "End_ms",
          "type": "temporal"
        },
        "opacity": {
          "condition": {
            "param": "interval_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.92
        }
      },
      "params": [
        {
          "name": "interval_hover",
          "select": {
            "type": "point",
            "fields": [
              "Event"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "name": "event-start",
      "mark": {
        "type": "point",
        "filled": false,
        "shape": "circle",
        "size": 225,
        "strokeWidth": 2.5,
        "cursor": "pointer"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "start_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.92
