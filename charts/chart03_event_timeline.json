{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected-endpoint interval timeline showing actual start and end dates of the 2026 in-person national surfing events.",
  "width": "container",
  "height": 600,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 8,
    "right": 12,
    "top": 30,
    "bottom": 8
  },
  "background": "#FAF9F6",
  "data": {
    "values": []
  },
  "encoding": {
    "x": {
      "field": "Start_ms",
      "type": "temporal",
      "scale": {
        "type": "utc",
        "domain": [
          {
            "year": 2026,
            "month": 1,
            "date": 1,
            "utc": true
          },
          {
            "year": 2027,
            "month": 1,
            "date": 1,
            "utc": true
          }
        ]
      },
      "axis": {
        "title": null,
        "format": "%b",
