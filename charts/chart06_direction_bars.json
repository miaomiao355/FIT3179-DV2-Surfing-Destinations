{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "January 2026 peak-wave direction readings grouped into eight compass sectors. Horizontal bars show each sector's share of valid readings; the dominant sector is highlighted.",
  "data": {
    "values": []
  },
  "width": "container",
  "height": 230,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 45,
    "top": 6,
    "bottom": 4
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 17,
        "cornerRadiusEnd": 0
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Segoe UI",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#314d55"
      },
      "encoding": {
        "text": {
          "field": "PercentLabel",
          "type": "nominal"
        },
        "color": {
          "value": "#223e4b"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          45
        ],
        "nice": false
      },
      "axis": {
        "title": "Valid readings (%)",
        "values": [
          0,
          10,
          20,
          30,
          40
        ],
        "labelExpr": "format(datum.value, '.0f') + '%'",
        "labelFont": "Segoe UI",
        "labelFontSize": 12,
        "labelColor": "#52616a",
        "titleFont": "Segoe UI",
        "titleFontSize": 12,
        "titleColor": "#344f57",
        "titlePadding": 7,
        "grid": true,
        "gridColor": "#e6edef",
        "tickSize": 3
      }
    },
    "y": {
      "field": "Sector",
      "type": "ordinal",
      "sort": [
        "N",
        "NE",
        "E",
        "SE",
        "S",
        "SW",
        "W",
        "NW"
      ],
      "axis": {
        "title": null,
        "labelFont": "Segoe UI",
        "labelFontSize": 12,
        "labelColor": "#344f57",
        "labelPadding": 4,
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "condition": {
        "test": "datum.IsDominant === true",
        "field": "Location",
        "type": "nominal",
        "scale": {
          "domain": [
            "Gold Coast",
            "Palm Beach",
            "Tweed Offshore"
          ],
          "range": [
            "#2A9D8F",
            "#8B6FB3",
            "#D08A2E"
          ]
        }
      },
      "value": "#d1dfe0",
      "legend": null
    },
    "tooltip": [
      {
        "field": "Location",
        "type": "nominal",
        "title": "Monitoring site"
      },
      {
        "field": "Sector",
        "type": "nominal",
        "title": "Direction sector"
      },
      {
        "field": "Count",
        "type": "quantitative",
        "title": "Valid readings",
        "format": ",d"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Share of valid readings (%)",
        "format": ".1f"
      },
      {
        "field": "ValidCount",
        "type": "quantitative",
        "title": "Total valid direction readings",
        "format": ",d"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
