{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mercator proportional-symbol map of January 2026 mean wave height with a simplified ABS mainland basemap.",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": "#D9EDF2",
  "projection": {
    "type": "mercator",
    "center": [
      153.47,
      -28.12
    ],
    "scale": {
      "expr": "max((width + 2) / 0.0178, (height + 2) / 0.0103)"
    }
  },
  "data": {
    "values": []
  },
  "layer": [
    {
      "name": "Simplified ABS mainland",
      "data": {
        "url": "data/chart04_land_editorial.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "stroke": null
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME_2026",
          "as": "State"
        }
      ],
      "encoding": {
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales"
            ],
            "range": [
              "#EAE7DC",
              "#E0E1D7"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "name": "ABS 2026 Queensland New South Wales boundary",
      "data": {
        "url": "data/chart04_state_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "fill": null,
        "stroke": "#AAA69B",
        "strokeWidth": 0.9
      }
    },
    {
      "name": "Queensland and New South Wales labels",
      "data": {
        "values": [
          {
            "label": "QUEENSLAND",
            "Longitude": 153.18,
            "Latitude": -27.97
          },
          {
            "label": "NEW SOUTH WALES",
            "Longitude": 153.23,
            "Latitude": -28.27
          }
        ]
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "font": "Segoe UI",
        "fontSize": 10,
        "fontWeight": 700,
        "letterSpacing": 0.9,
        "color": "#697e82",
        "opacity": 0.85,
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#697e82"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "verified locality points",
      "data": {
        "url": "data/chart04_context_places.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "circle",
        "interactive": false,
        "size": 20,
        "color": "#526b71",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "Place"
        },
        {
          "calculate": "datum.properties.state",
          "as": "State"
        },
        {
          "calculate": "datum.properties.source",
          "as": "Place_name_source"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "datum.Place === 'Tweed Heads'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Place",
            "type": "nominal",
            "title": "Place"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Place_name_source",
            "type": "nominal",
            "title": "Place-name source"
          }
        ]
      }
    },
    {
      "name": "Tweed Heads locality label",
      "data": {
        "url": "data/chart04_context_places.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -8,
        "dy": 14,
        "align": "right",
        "baseline": "top",
        "font": "Segoe UI",
        "fontSize": 11,
        "fontWeight": 400,
        "color": "#173B4A"
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "Place"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "datum.Place === 'Tweed Heads'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Place",
          "type": "nominal"
        }
      }
    },
    {
      "name": "mean significant wave-height symbols",
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.96,
        "stroke": "#ffffff",
        "strokeWidth": 1.8,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2
            ],
            "range": [
              0,
              600
            ],
            "zero": true
          },
          "legend": null
        },
        "color": {
          "field": "Location",
          "type": "nominal",
          "scale": {
            "domain": [
              "Gold Coast",
              "Palm Beach",
              "Tweed Offshore"
            ],
            "range": [
              "#2A9D8F",
              "#8B6FB3",
              "#D08A2E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Location",
            "type": "nominal",
            "title": "Monitoring site"
          },
          {
            "field": "Longitude",
            "type": "quantitative",
            "title": "Longitude (°E)",
            "format": ".6f"
          },
          {
            "field": "Latitude",
            "type": "quantitative",
            "title": "Latitude (°)",
            "format": ".6f"
          },
          {
            "field": "Mean_Hs_m",
            "type": "quantitative",
            "title": "Mean significant wave height (m)",
            "format": ".3f"
          },
          {
            "field": "Mean_Tp_s",
            "type": "quantitative",
            "title": "Mean peak period (s)",
            "format": ".2f"
          },
          {
            "field": "Valid_Hs_records",
            "type": "quantitative",
            "title": "Valid Hs observations",
            "format": "d"
          },
          {
            "field": "Valid_Tp_records",
            "type": "quantitative",
            "title": "Valid Tp observations",
            "format": "d"
          },
          {
            "field": "Observation_period",
            "type": "nominal",
            "title": "Observation period"
          }
        ]
      }
    },
    {
      "name": "gold-coast-site-label-name",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": -8,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Gold Coast'"
        }
      ]
    },
    {
      "name": "gold-coast-site-label-value",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": 9,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "ValueLabel",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Gold Coast'"
        },
        {
          "calculate": "format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "ValueLabel"
        }
      ]
    },
    {
      "name": "palm-beach-site-label-name",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": -8,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Palm Beach'"
        }
      ]
    },
    {
      "name": "palm-beach-site-label-value",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": 9,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "ValueLabel",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Palm Beach'"
        },
        {
          "calculate": "format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "ValueLabel"
        }
      ]
    },
    {
      "name": "tweed-offshore-site-label-name",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -22,
        "dy": 25,
        "align": "center",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Tweed Offshore'"
        }
      ]
    },
    {
      "name": "tweed-offshore-site-label-value",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -22,
        "dy": 40,
        "align": "center",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "ValueLabel",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Tweed Offshore'"
        },
        {
          "calculate": "format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "ValueLabel"
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "text": {
      "font": "Segoe UI"
    },
    "font": "Segoe UI",
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
