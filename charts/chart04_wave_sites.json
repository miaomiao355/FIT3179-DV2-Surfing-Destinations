      "data": {
        "values": [
          {
            "Location": "Tweed Offshore",
            "Longitude": 153.680283,
            "Latitude": -28.212
          }
        ]
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 9,
        "dy": 13,
        "align": "left",
        "baseline": "top",
        "font": "Arial",
        "fontSize": 10,
        "fontWeight": 700,
