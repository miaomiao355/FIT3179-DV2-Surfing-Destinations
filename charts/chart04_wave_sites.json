{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of January 2026 mean significant wave height at Gold Coast, Palm Beach and Tweed Offshore. Official Queensland and NSW coastline linework is shown over ABS ASGS 2026 state areas.",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": "#dfeef2",
  "projection": {
    "type": "mercator",
    "center": [
      153.47,
      -28.12
    ],
    "scale": {
      "expr": "min((width - 42) / 0.0178, (height - 46) / 0.0103)"
    }
  },
  "data": {
    "values": []
  },
  "layer": [
    {
      "name": "ABS 2026 Queensland and NSW land areas",
      "data": {
        "url": "data/chart04_state_areas.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "stroke": null
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME_2026",
          "as": "State"
        }
      ],
      "encoding": {
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales"
            ],
            "range": [
              "#f4f1e8",
              "#e9eee8"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "name": "official Queensland and NSW coastlines",
      "data": {
        "url": "data/chart04_coastlines.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "fill": null,
        "stroke": "#5f7f88",
        "strokeWidth": 1.25,
        "opacity": 0.96
      }
    },
    {
      "name": "ABS 2026 Queensland New South Wales boundary",
      "data": {
        "url": "data/chart04_state_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "fill": null,
        "stroke": "#49656d",
        "strokeWidth": 1.25,
        "opacity": 0.88
      }
    },
    {
      "name": "Queensland and New South Wales labels",
      "data": {
        "values": [
          {
            "label": "QLD",
            "Longitude": 153.12,
            "Latitude": -27.965
          },
          {
            "label": "NSW",
            "Longitude": 153.12,
            "Latitude": -28.255
          }
        ]
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": 700,
        "letterSpacing": 0.9,
        "color": "#173B4A",
        "opacity": 0.9,
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "verified locality points",
      "data": {
        "url": "data/chart04_context_places.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "circle",
        "interactive": true,
        "size": 26,
        "color": "#526b71",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "Place"
        },
        {
          "calculate": "datum.properties.state",
          "as": "State"
        },
        {
          "calculate": "datum.properties.source",
          "as": "Place_name_source"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Place",
            "type": "nominal",
            "title": "Place"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Place_name_source",
            "type": "nominal",
            "title": "Place-name source"
          }
        ]
      }
    },
    {
      "name": "Gold Coast locality label",
      "data": {
        "url": "data/chart04_context_places.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -9,
        "dy": 18,
        "align": "right",
        "baseline": "top",
        "font": "Arial",
        "fontSize": 9,
        "fontWeight": 700,
        "color": "#173B4A"
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "Place"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "datum.Place === 'Gold Coast'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Place",
          "type": "nominal"
        }
      }
    },
    {
      "name": "Tweed Heads locality label",
      "data": {
        "url": "data/chart04_context_places.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -9,
        "dy": -12,
        "align": "right",
        "baseline": "bottom",
        "font": "Arial",
        "fontSize": 9,
        "fontWeight": 700,
        "color": "#173B4A"
      },
      "transform": [
        {
          "calculate": "datum.properties.name",
          "as": "Place"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "datum.Place === 'Tweed Heads'"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Place",
          "type": "nominal"
        }
      }
    },
    {
      "name": "mean significant wave-height symbols",
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.96,
        "stroke": "#ffffff",
        "strokeWidth": 1.8,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2
            ],
            "range": [
              0,
              600
            ],
            "zero": true
          },
          "legend": null
        },
        "color": {
          "field": "Location",
          "type": "nominal",
          "scale": {
            "domain": [
              "Gold Coast",
              "Palm Beach",
              "Tweed Offshore"
            ],
            "range": [
              "#0072b2",
              "#0072b2",
              "#d55e00"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Location",
            "type": "nominal",
            "title": "Monitoring site"
          },
          {
            "field": "Longitude",
            "type": "quantitative",
            "title": "Longitude (°E)",
            "format": ".6f"
          },
          {
            "field": "Latitude",
            "type": "quantitative",
            "title": "Latitude (°)",
            "format": ".6f"
          },
          {
            "field": "Mean_Hs_m",
            "type": "quantitative",
            "title": "Mean significant wave height (m)",
            "format": ".3f"
          },
          {
            "field": "Mean_Tp_s",
            "type": "quantitative",
            "title": "Mean peak period (s)",
            "format": ".2f"
          },
          {
            "field": "Valid_Hs_records",
            "type": "quantitative",
            "title": "Valid Hs observations",
            "format": "d"
          },
          {
            "field": "Valid_Tp_records",
            "type": "quantitative",
            "title": "Valid Tp observations",
            "format": "d"
          },
          {
            "field": "Observation_period",
            "type": "nominal",
            "title": "Observation period"
          }
        ]
      }
    },
    {
      "name": "gold-coast-site-label",
      "data": {
        "values": [
          {
            "Location": "Gold Coast",
            "Longitude": 153.44095,
            "Latitude": -27.9649
          }
        ]
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 9,
        "dy": -14,
        "align": "left",
        "baseline": "bottom",
        "font": "Arial",
        "fontSize": 10,
