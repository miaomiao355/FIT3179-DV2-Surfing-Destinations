{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of January 2026 mean significant wave height at Gold Coast, Palm Beach and Tweed Offshore. Official Queensland and NSW coastline linework is shown over ABS ASGS 2026 state areas.",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": "#dcecf0",
  "projection": {
    "type": "mercator",
    "center": [
      153.47,
      -28.12
    ],
    "scale": {
      "expr": "min((width - 42) / 0.0178, (height - 46) / 0.0103)"
    }
  },
  "data": {
    "values": []
  },
  "layer": [
    {
      "name": "ABS 2026 Queensland and NSW land areas",
      "data": {
        "url": "data/chart04_state_areas.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "stroke": null
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME_2026",
          "as": "State"
        }
      ],
      "encoding": {
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales"
            ],
            "range": [
              "#e8ece7",
              "#e8ece7"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "name": "official Queensland and NSW coastlines",
      "data": {
        "url": "data/chart04_coastlines.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "fill": null,
        "stroke": "#8aadb9",
        "strokeWidth": 0.8
      }
    },
    {
      "name": "ABS 2026 Queensland New South Wales boundary",
      "data": {
        "url": "data/chart04_state_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "interactive": false,
        "fill": null,
        "stroke": "#b5c8c8",
        "strokeWidth": 0.8
      }
    },
    {
      "name": "Queensland and New South Wales labels",
      "data": {
        "values": [
          {
            "label": "QLD",
            "Longitude": 153.12,
            "Latitude": -27.965
          },
          {
            "label": "NSW",
            "Longitude": 153.12,
            "Latitude": -28.255
          }
        ]
      },
      "mark": {
        "type": "text",
        "interactive": false,
        "font": "Segoe UI",
        "fontSize": 11,
        "fontWeight": 700,
        "letterSpacing": 0.9,
        "color": "#173B4A",
        "opacity": 0.9,
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "mean significant wave-height symbols",
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.96,
        "stroke": "#ffffff",
        "strokeWidth": 1.8,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2
            ],
            "range": [
              0,
              600
            ],
            "zero": true
          },
          "legend": null
        },
        "color": {
          "field": "Location",
          "type": "nominal",
          "scale": {
            "domain": [
              "Gold Coast",
              "Palm Beach",
              "Tweed Offshore"
            ],
            "range": [
              "#2A9D8F",
              "#8B6FB3",
              "#D08A2E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Location",
            "type": "nominal",
            "title": "Monitoring site"
          },
          {
            "field": "Longitude",
            "type": "quantitative",
            "title": "Longitude (°E)",
            "format": ".6f"
          },
          {
            "field": "Latitude",
            "type": "quantitative",
            "title": "Latitude (°)",
            "format": ".6f"
          },
          {
            "field": "Mean_Hs_m",
            "type": "quantitative",
            "title": "Mean significant wave height (m)",
            "format": ".3f"
          },
          {
            "field": "Mean_Tp_s",
            "type": "quantitative",
            "title": "Mean peak period (s)",
            "format": ".2f"
          },
          {
            "field": "Valid_Hs_records",
            "type": "quantitative",
            "title": "Valid Hs observations",
            "format": "d"
          },
          {
            "field": "Valid_Tp_records",
            "type": "quantitative",
            "title": "Valid Tp observations",
            "format": "d"
          },
          {
            "field": "Observation_period",
            "type": "nominal",
            "title": "Observation period"
          }
        ]
      }
    },
    {
      "name": "gold-coast-site-label",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": 0,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Gold Coast'"
        },
        {
          "calculate": "datum.Location + '  ' + format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "Label"
        }
      ]
    },
    {
      "name": "palm-beach-site-label",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": 18,
        "dy": 0,
        "align": "left",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Palm Beach'"
        },
        {
          "calculate": "datum.Location + '  ' + format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "Label"
        }
      ]
    },
    {
      "name": "tweed-offshore-site-label",
      "mark": {
        "type": "text",
        "interactive": false,
        "dx": -18,
        "dy": 0,
        "align": "right",
        "baseline": "middle",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102b3a"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "value": "#173B4A"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Tweed Offshore'"
        },
        {
          "calculate": "datum.Location + '  ' + format(datum.Mean_Hs_m, '.3f') + ' m'",
          "as": "Label"
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "text": {
      "font": "Segoe UI"
    },
    "font": "Segoe UI",
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
