{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Equal Earth geographic detail of the eastern and southern mapped Surfing Australia 2026 venues; the same events are represented on the national map.",
  "width": "container",
  "height": "container",
  "background": "#E8F3F4",
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "center": [
      0,
      -33.4
    ],
    "rotate": [
      -149.3,
      0
    ],
    "scale": {
      "expr": "min(width * 5.3, height * 3.4)"
    }
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All"
    },
    {
      "name": "focus_event",
      "value": ""
    }
  ],
  "layer": [
    {
      "name": "australia-base",
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8DDC8",
        "stroke": "#AAA69B",
        "strokeWidth": 1,
        "clip": true
      }
    },
    {
      "name": "event-locations",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude) && datum.Latitude < 0 && datum.Longitude > 100"
        },
        {
          "filter": "state_filter === 'All' || datum.State === state_filter"
        },
        {
          "filter": "datum.State !== 'WA'"
        }
      ],
      "params": [
        {
          "name": "event_hover",
          "select": {
            "type": "point",
            "fields": [
              "Event"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FAF9F6",
        "strokeWidth": 2,
        "opacity": 0.95,
        "cursor": "pointer",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": 440
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": 350
            }
          ],
          "value": 260
        },
        "color": {
          "condition": {
            "test": "datum.Location === 'Margaret River'",
            "value": "#E66B35"
          },
          "value": "#16758A"
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Event"
          },
          {
            "field": "Location",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Start_Date",
            "type": "temporal",
            "title": "Starts",
            "format": "%d %b %Y"
          },
          {
            "field": "End_Date",
            "type": "temporal",
            "title": "Ends",
            "format": "%d %b %Y"
          },
          {
            "field": "Event_Type",
            "type": "nominal",
            "title": "Category"
          }
        ],
        "stroke": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": "#102B3A"
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": "#102B3A"
            }
          ],
          "value": "#FAF9F6"
        },
        "strokeWidth": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": 3
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": 3
            }
          ],
          "value": 2
        }
      }
    },
    {
      "name": "label-gold-coast",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Gold Coast' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "dy": -12,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    },
    {
      "name": "label-byron-bay",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Byron Bay' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "dy": 15,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    },
    {
      "name": "label-newcastle",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Newcastle' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "dy": -5,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    },
    {
      "name": "label-wollongong",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Wollongong' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "dy": 8,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    },
    {
      "name": "label-bells-beach",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Bells Beach' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -16,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    },
    {
      "name": "label-phillip-island",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Phillip Island' && (state_filter === 'All' || datum.State === state_filter)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#102B3A",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": 16,
        "interactive": false,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
