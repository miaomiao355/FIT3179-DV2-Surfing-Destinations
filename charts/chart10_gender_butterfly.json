{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A mirrored butterfly chart comparing 2025 male and female surfing participation rates for the AusPlay Adults and Children populations.",
  "data": {
    "values": []
  },
  "width": "container",
  "height": 230,
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 34,
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "x": {
          "field": "ZeroRate",
          "type": "quantitative",
          "scale": {
            "domain": [
              -2.3,
              2.3
            ],
            "nice": false
          },
          "axis": {
            "title": "Participation rate (%) ? equal scales",
            "values": [
              -2,
              -1,
              0,
              1,
              2
            ],
            "labelExpr": "format(abs(datum.value), '.1f') + '%'",
            "grid": true,
            "gridColor": "#e7eef0",
            "labelColor": "#526a72",
            "titleColor": "#314d55",
            "titlePadding": 12
          }
        },
        "x2": {
          "field": "PlotRate"
        },
        "y": {
          "field": "PopulationLabel",
          "type": "ordinal",
          "sort": [
            "Adults",
            "Children"
          ],
          "axis": {
            "title": null,
            "labelColor": "#314d55",
            "labelFontSize": 12,
            "labelPadding": 9,
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Female",
              "Male"
            ],
            "range": [
              "#8668A6",
              "#23877D"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "PopulationLabel",
            "type": "ordinal",
            "title": "AusPlay population"
          },
          {
            "field": "Sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "RatePercent",
            "type": "quantitative",
            "title": "Participation rate (%)",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "rows"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#263d42",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -2.3,
              2.3
            ],
            "nice": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sex === 'Female'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#263d42"
      },
      "encoding": {
        "x": {
          "field": "PlotRate",
          "type": "quantitative",
          "scale": {
            "domain": [
              -2.3,
              2.3
            ],
            "nice": false
          }
        },
        "y": {
          "field": "PopulationLabel",
          "type": "ordinal",
          "sort": [
            "Adults",
            "Children"
          ]
        },
        "text": {
          "field": "RateLabel",
          "type": "nominal"
        },
        "color": {
          "value": "#263d42"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sex === 'Male'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#263d42"
      },
      "encoding": {
        "x": {
          "field": "PlotRate",
          "type": "quantitative",
          "scale": {
            "domain": [
              -2.3,
              2.3
            ],
            "nice": false
          }
        },
        "y": {
          "field": "PopulationLabel",
          "type": "ordinal",
          "sort": [
            "Adults",
            "Children"
          ]
        },
        "text": {
          "field": "RateLabel",
          "type": "nominal"
        },
        "color": {
          "value": "#263d42"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "titleFontWeight": 700,
      "labelFontSize": 12,
      "domainColor": "#9fb4b8",
      "tickColor": "#9fb4b8",
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "font": "Segoe UI",
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
