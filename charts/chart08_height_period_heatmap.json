{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Counts of valid paired significant wave height and peak period readings, grouped into common bins across all three sites.",
  "data": {
    "values": []
  },
  "width": "container",
  "height": 345,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 0.4
  },
  "encoding": {
    "x": {
      "field": "HsStart",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          3.5
        ],
        "nice": false
      },
      "axis": {
        "title": "Significant wave height, Hs (m)",
        "values": [
          0,
          1,
          2,
          3
        ],
        "labelFont": "Segoe UI",
        "labelFontSize": 12,
        "titleFont": "Segoe UI",
        "titleFontSize": 12,
        "grid": false,
        "gridColor": "#e7edef",
        "tickSize": 3
      }
    },
    "x2": {
      "field": "HsEnd",
      "type": "quantitative"
    },
    "y": {
      "field": "TpStart",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          20
        ],
        "nice": false
      },
      "axis": {
        "title": "Peak period, Tp (s)",
        "values": [
          0,
          5,
          10,
          15,
          20
        ],
        "labelFont": "Segoe UI",
        "labelFontSize": 12,
        "titleFont": "Segoe UI",
        "titleFontSize": 12,
        "grid": false,
        "gridColor": "#e7edef",
        "tickSize": 3
      }
    },
    "y2": {
      "field": "TpEnd",
      "type": "quantitative"
    },
    "color": {
      "field": "Count",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          44.75,
          89.5,
          134.25,
          179
        ],
        "clamp": true,
        "range": [
          "#F4F0F8",
          "#D9C9E9",
          "#AD91CE",
          "#75549F",
          "#422868"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "Location",
        "type": "nominal",
        "title": "Monitoring site"
      },
      {
        "field": "HsRange",
        "type": "nominal",
        "title": "Hs bin"
      },
      {
        "field": "TpRange",
        "type": "nominal",
        "title": "Tp bin"
      },
      {
        "field": "Count",
        "type": "quantitative",
        "title": "Observations",
        "format": ",d"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
