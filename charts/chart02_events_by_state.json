{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Count of state-assigned entries in the Surfing Australia 2026 national event calendar, joined to Australian state boundary GeoJSON.",
  "width": "container",
  "height": "container",
  "padding": 12,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#FAF9F6",
  "projection": {
    "type": "equalEarth",
    "center": [
      134,
      -27
    ],
    "rotate": [
      0,
      0
    ],
    "scale": {
      "expr": "min(width * 1.48, height * 1.42)"
    }
  },
  "data": {
    "values": []
  },
  "params": [
    {
      "name": "state_hover",
      "select": {
        "type": "point",
        "fields": [
          "state_name"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    },
    {
      "name": "selected_state",
      "value": ""
    }
  ],
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },
    {
      "calculate": "datum.properties.event_count",
      "as": "event_count"
    }
  ],
  "mark": {
    "type": "geoshape",
    "cursor": "pointer",
    "stroke": "#B9B2A6",
    "strokeWidth": 1.15
  },
  "encoding": {
    "color": {
      "field": "event_count",
      "type": "ordinal",
      "scale": {
        "domain": [
          0,
          1,
          2,
          3,
          4
        ],
        "range": [
          "#EAE6DE",
          "#F4CBA5",
          "#D98550",
          "#B8643A",
          "#8E412B"
        ]
      },
      "legend": {
        "title": "2026 national event count",
        "orient": "bottom",
        "direction": "horizontal",
        "values": [
          0,
          1,
          2,
          3,
          4
        ],
        "columns": 5,
        "symbolType": "square",
        "symbolSize": 160,
        "labelFontSize": 13,
        "titleFontSize": 13
      }
    },
    "stroke": {
      "condition": [
        {
          "test": "selected_state !== '' && datum.state_name === selected_state",
          "value": "#102B3A"
        },
        {
          "param": "state_hover",
          "empty": false,
          "value": "#6B615A"
        }
      ],
      "value": "#B9B2A6"
    },
    "strokeWidth": {
      "condition": [
        {
          "test": "selected_state !== '' && datum.state_name === selected_state",
          "value": 2.2
        },
        {
          "param": "state_hover",
          "empty": false,
          "value": 1.6
        }
      ],
      "value": 0.8
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "event_count",
        "type": "quantitative",
        "title": "National calendar events",
        "format": "d"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#344e5b",
      "titleColor": "#183d50",
      "gridColor": "#e4eceb",
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#344e5b",
      "titleColor": "#183d50",
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "font": "Segoe UI"
  }
}
