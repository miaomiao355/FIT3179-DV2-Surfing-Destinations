{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Seven verifiable Surfing Australia 2026 event venue coordinates, with state boundaries and contextual labels.",
  "width": "container",
  "height": "container",
  "background": "#eef5f5",
  "padding": {
    "left": 10,
    "top": 8,
    "right": 10,
    "bottom": 8
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "center": [
      134,
      -27
    ],
    "rotate": [
      0,
      0
    ],
    "scale": {
      "expr": "min(width * 1.62, height * 1.38)"
    }
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All"
    },
    {
      "name": "focus_event",
      "value": ""
    }
  ],
  "layer": [
    {
      "name": "australia-base",
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fbf7",
        "stroke": "#789b9e",
        "strokeWidth": 1.6
      }
    },
    {
      "name": "state-abbreviations",
      "data": {
        "values": [
          {
            "label": "WA",
            "lon": 123.2,
            "lat": -26.7
          },
          {
            "label": "NT",
            "lon": 133.5,
            "lat": -20.4
          },
          {
            "label": "QLD",
            "lon": 145,
            "lat": -22.0
          },
          {
            "label": "SA",
            "lon": 136.0,
            "lat": -30.1
          },
          {
            "label": "NSW",
            "lon": 146.0,
            "lat": -32.8
          },
          {
            "label": "VIC",
            "lon": 143.8,
            "lat": -37.0
          },
          {
            "label": "TAS",
            "lon": 146.7,
            "lat": -42.0
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#77969b",
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "event-locations",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude) && datum.Latitude < 0 && datum.Longitude > 100"
        },
        {
          "filter": "state_filter === 'All' || datum.State === state_filter"
        }
      ],
      "params": [
        {
          "name": "event_hover",
          "select": {
            "type": "point",
            "fields": [
              "Event"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "opacity": 0.95,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": 440
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": 350
            }
          ],
          "value": 220
        },
        "color": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": "#E69F00"
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": "#E69F00"
            }
          ],
          "value": "#176b76"
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Event"
          },
          {
            "field": "Location",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Start_Date",
            "type": "temporal",
            "title": "Starts",
            "format": "%d %b %Y"
          },
          {
            "field": "End_Date",
            "type": "temporal",
            "title": "Ends",
            "format": "%d %b %Y"
          },
          {
            "field": "Event_Type",
            "type": "nominal",
            "title": "Category"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
