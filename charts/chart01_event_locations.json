{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Seven verifiable Surfing Australia 2026 event venue coordinates, with state boundaries and contextual labels.",
  "width": "container",
  "height": "container",
  "background": "#E8F3F4",
  "padding": {
    "left": 10,
    "top": 8,
    "right": 10,
    "bottom": 8
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "center": [
      134,
      -27
    ],
    "rotate": [
      0,
      0
    ],
    "scale": {
      "expr": "min(width * 1.52, height * 1.42)"
    }
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All"
    },
    {
      "name": "focus_event",
      "value": ""
    }
  ],
  "layer": [
    {
      "name": "australia-base",
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8DDC8",
        "stroke": "#AAA69B",
        "strokeWidth": 1
      }
    },
    {
      "name": "state-abbreviations",
      "data": {
        "values": [
          {
            "label": "WA",
            "lon": 123.2,
            "lat": -26.7
          },
          {
            "label": "NT",
            "lon": 133.5,
            "lat": -20.4
          },
          {
            "label": "QLD",
            "lon": 145,
            "lat": -22
          },
          {
            "label": "SA",
            "lon": 136,
            "lat": -30.1
          },
          {
            "label": "NSW",
            "lon": 146,
            "lat": -32.8
          },
          {
            "label": "VIC",
            "lon": 143.8,
            "lat": -37
          },
          {
            "label": "TAS",
            "lon": 146.7,
            "lat": -42
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#54636A",
        "opacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "western-outlier-leader",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Margaret River' && (state_filter === 'All' || datum.State === state_filter)"
        },
        {
          "calculate": "datum.Longitude + 2.2",
          "as": "AnnotationLon"
        },
        {
          "calculate": "datum.Latitude - 2.4",
          "as": "AnnotationLat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#E66B35",
        "strokeWidth": 1.5,
        "interactive": false
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "AnnotationLon",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "AnnotationLat",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "event-locations",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude) && datum.Latitude < 0 && datum.Longitude > 100"
        },
        {
          "filter": "state_filter === 'All' || datum.State === state_filter"
        }
      ],
      "params": [
        {
          "name": "event_hover",
          "select": {
            "type": "point",
            "fields": [
              "Event"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FAF9F6",
        "strokeWidth": 2,
        "opacity": 0.95,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": 440
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": 350
            }
          ],
          "value": 260
        },
        "color": {
          "condition": {
            "test": "datum.Location === 'Margaret River'",
            "value": "#E66B35"
          },
          "value": "#16758A"
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Event"
          },
          {
            "field": "Location",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Start_Date",
            "type": "temporal",
            "title": "Starts",
            "format": "%d %b %Y"
          },
          {
            "field": "End_Date",
            "type": "temporal",
            "title": "Ends",
            "format": "%d %b %Y"
          },
          {
            "field": "Event_Type",
            "type": "nominal",
            "title": "Category"
          }
        ],
        "stroke": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": "#102B3A"
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": "#102B3A"
            }
          ],
          "value": "#FAF9F6"
        },
        "strokeWidth": {
          "condition": [
            {
              "test": "focus_event !== '' && datum.Event === focus_event",
              "value": 3
            },
            {
              "param": "event_hover",
              "empty": false,
              "value": 3
            }
          ],
          "value": 2
        }
      }
    },
    {
      "name": "western-outlier-label",
      "data": {
        "url": "data/surfing_australia_events_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Location === 'Margaret River' && (state_filter === 'All' || datum.State === state_filter)"
        },
        {
          "calculate": "datum.Longitude + 2.2",
          "as": "AnnotationLon"
        },
        {
          "calculate": "datum.Latitude - 2.4",
          "as": "AnnotationLat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 5,
        "dy": 3,
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#9C421C",
        "interactive": false
      },
      "encoding": {
        "longitude": {
          "field": "AnnotationLon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "AnnotationLat",
          "type": "quantitative"
        },
        "text": {
          "value": "Margaret River · western outlier"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
