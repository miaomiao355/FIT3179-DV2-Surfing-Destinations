{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Aligned horizontal comparison of January 2026 mean significant wave height at the three monitoring sites. Bars share a zero-based 0 to 2 metre scale.",
  "width": "container",
  "height": 170,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 2,
    "right": 48,
    "top": 6,
    "bottom": 2
  },
  "background": null,
  "data": {
    "values": []
  },
  "layer": [
    {
      "name": "shared-baseline-wave-height-bars",
      "mark": {
        "type": "bar",
        "height": 22,
        "cornerRadiusEnd": 0,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "Location",
          "type": "nominal",
          "sort": [
            "Gold Coast",
            "Palm Beach",
            "Tweed Offshore"
          ],
          "axis": null
        },
        "x": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2
            ],
            "nice": false,
            "zero": true
          },
          "axis": {
            "title": "Mean significant wave height (m)",
            "titleFont": "Segoe UI",
            "titleFontSize": 12,
            "titleColor": "#536970",
            "titlePadding": 10,
            "labelFont": "Segoe UI",
            "labelFontSize": 12,
            "labelColor": "#667a80",
            "format": ".1f",
            "values": [
              0,
              0.5,
              1,
              1.5,
              2
            ],
            "grid": true,
            "gridColor": "#e6ecec",
            "gridWidth": 1,
            "domain": false,
            "tickColor": "#bdcdcf",
            "tickSize": 3
          }
        },
        "color": {
          "field": "Location",
          "type": "nominal",
          "scale": {
            "domain": [
              "Gold Coast",
              "Palm Beach",
              "Tweed Offshore"
            ],
            "range": [
              "#2A9D8F",
              "#8B6FB3",
              "#D08A2E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Location",
            "type": "nominal",
            "title": "Monitoring site"
          },
          {
            "field": "Mean_Hs_m",
            "type": "quantitative",
            "title": "January mean Hs (m)",
            "format": ".3f"
          },
          {
            "field": "Mean_Tp_s",
            "type": "quantitative",
            "title": "Mean peak period (s)",
            "format": ".2f"
          },
          {
            "field": "Valid_Hs_records",
            "type": "quantitative",
            "title": "Valid Hs observations",
            "format": "d"
          },
          {
            "field": "Observation_period",
            "type": "nominal",
            "title": "Observation period"
          }
        ]
      }
    },
    {
      "name": "exact-three-decimal-wave-height-labels",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#2c454c",
        "clip": false
      },
      "encoding": {
        "y": {
          "field": "Location",
          "type": "nominal",
          "sort": [
            "Gold Coast",
            "Palm Beach",
            "Tweed Offshore"
          ],
          "axis": null
        },
        "x": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2
            ],
            "nice": false,
            "zero": true
          },
          "axis": null
        },
        "text": {
          "field": "Mean_Hs_m",
          "type": "quantitative",
          "format": ".3f"
        }
      }
    },
    {
      "name": "monitoring-site-names",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dy": -16,
        "font": "Segoe UI",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173B4A",
        "interactive": false
      },
      "encoding": {
        "y": {
          "field": "Location",
          "type": "nominal",
          "sort": [
            "Gold Coast",
            "Palm Beach",
            "Tweed Offshore"
          ],
          "axis": null
        },
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2
            ],
            "nice": false,
            "zero": true
          },
          "axis": null
        },
        "text": {
          "field": "Location",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    },
    "legend": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#344e5b",
      "titleColor": "#183d50"
    }
  }
}
